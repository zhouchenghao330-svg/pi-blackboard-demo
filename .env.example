# Host port for the demo service.
DEMO_PORT=3000

# Set both values to register a model in Pi. The URL must be reachable from
# inside the container. For a model running on this Mac, use
# http://host.docker.internal:<port>/v1 rather than localhost.
DEMO_MODEL_BASE_URL=
DEMO_MODEL_ID=
DEMO_MODEL_API=openai-completions
DEMO_MODEL_API_KEY=
DEMO_MODEL_VISION=true

# Defaults target Qwen served by vLLM. Pi maps UI levels to reasoning budgets.
DEMO_MODEL_REASONING=true
DEMO_MODEL_THINKING_FORMAT=qwen-chat-template
DEMO_MODEL_THINKING_BUDGET_FIELD=thinking_token_budget
