# Host port for the demo service.
DEMO_PORT=3000
MAX_PDF_PAGES=100

# Set both values to register a model in Pi. The URL must be reachable from
# inside the container. For a model running on this Mac, use
# http://host.docker.internal:<port>/v1 rather than localhost.
DEMO_MODEL_BASE_URL=
DEMO_MODEL_ID=
# Required for Pi auto-compaction and the context meter on custom models.
# deepseek-flash defaults to a 262144-token working window; set this for other models.
DEMO_MODEL_CONTEXT_WINDOW=
DEMO_MODEL_API=openai-completions
DEMO_MODEL_API_KEY=
DEMO_MODEL_VISION=true

# Defaults target Qwen served by vLLM. Pi maps UI levels to reasoning budgets.
DEMO_MODEL_REASONING=true
DEMO_MODEL_THINKING_FORMAT=qwen-chat-template
DEMO_MODEL_THINKING_BUDGET_FIELD=thinking_token_budget

# Tavily key for the Agent's web_search tool. Keep the real key in .env only.
TAVILY_API_KEY=

# Real SMTP credentials are needed to send meeting risk emails.
MEETING_SMTP_HOST=
MEETING_SMTP_PORT=587
MEETING_SMTP_USER=
MEETING_SMTP_PASS=
MEETING_SMTP_FROM=
