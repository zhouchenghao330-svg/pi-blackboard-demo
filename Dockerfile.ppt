FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv fontconfig fonts-noto-cjk ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/ppt-venv \
    && /opt/ppt-venv/bin/pip install --no-cache-dir \
      python-pptx XlsxWriter skia-pathops uharfbuzz Pillow numpy PyYAML fonttools

ENV PATH=/opt/ppt-venv/bin:$PATH \
    NODE_ENV=production \
    DEMO_DATA_DIR=/data \
    PI_CODING_AGENT_DIR=/data/ppt-pi-agent \
    PPT_MASTER_SKILL_DIR=/opt/ppt-master/skills/ppt-master

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev && npm cache clean --force
COPY src/configure-pi.mjs src/ppt-store.mjs src/ppt-worker.mjs ./src/
COPY vendor/ppt-master/skills/ppt-master /opt/ppt-master/skills/ppt-master
RUN mkdir -p /data && chown -R node:node /data

USER node
CMD ["node", "src/ppt-worker.mjs"]
